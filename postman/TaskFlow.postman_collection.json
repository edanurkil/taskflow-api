{
  "info": {
    "name": "TaskFlow API",
    "description": "TaskFlow REST API test koleksiyonu. Sunucuyu başlatın (npm start), sonra koleksiyonu klasör sırasıyla çalıştırın (Collection Runner).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Çalışanlar (CRUD)",
      "item": [
        {
          "name": "1. Çalışan ekle",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user{{$timestamp}}\",\n  \"name\": \"Test Çalışanı\",\n  \"email\": \"user{{$timestamp}}@taskflow.dev\",\n  \"role\": \"Developer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 201\", () => pm.response.to.have.status(201));",
                  "const emp = pm.response.json();",
                  "pm.collectionVariables.set(\"employeeId\", emp.id);",
                  "pm.collectionVariables.set(\"employeeUsername\", emp.username);",
                  "pm.test(\"Çalışan id ve username döndü\", () => pm.expect(emp).to.have.property(\"username\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Çalışanları listele",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"data dizisi var\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Çalışan detayı",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Çalışan güncelle",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "employees",
                "{{employeeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"Senior Developer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Durum kodu 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Rol güncellendi\", () => pm.expect(pm.response.json().role).to.eql(\"Senior Developer\"));"
                ]
              }
            }
          ]
        }
      ]
